<?xml version="1.0" encoding="utf-8"?>
<!-- Three ascending bars, stroke-only to match the other outline nav icons.
     Rounds caps let the bars read as bars rather than ticks at 24dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="256"
    android:viewportHeight="256">
    <path
        android:pathData="M64,152 L64,192"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="16"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M128,104 L128,192"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="16"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M192,56 L192,192"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="16"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
